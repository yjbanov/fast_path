pubspec.lock

# Conventional directory for build outputs.
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# IDE files.
.idea/
.vscode/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Sandbox leftovers (safe to delete on host)
.git.broken/
